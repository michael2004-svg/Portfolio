# Copy to .env on the VPS (/opt/deploy/applications/portfolio/.env). Never commit .env.

# Shared PostgreSQL — use the container's Docker DNS name, not localhost.
DATABASE_URL="postgresql://portfolio:CHANGE_ME@postgres:5432/portfolio?schema=public"

# 32+ random chars: openssl rand -base64 48
SESSION_SECRET=""

# Admin dashboard login (/admin)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public URL used in emails (invite, review and notification links)
SITE_URL="https://michaelmusyoka.com"
# Requests whose host starts with this are served the booking site
BOOKING_HOST_PREFIX="booking."

# SMTP for lead alerts, client invites and review requests
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Michael Musyoka <hello@michaelmusyoka.com>"
# Where new-lead / review alerts go (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=""
